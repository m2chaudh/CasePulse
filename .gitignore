# Data directory - contains tokens, emails, attachments, vector DB
data/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual environment
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment files
.env
*.env.local

# Config with secrets
config.json

# Brainstorming visual companion (mockups, transient)
.superpowers/

# Test coverage state
.coverage
htmlcov/

# Stray SQLite files (the real DB lives under data/, which is already
# ignored). Keeps a passing Database() invocation from the project root
# from leaving a 0-byte casepulse.db behind for accidental commits.
*.db
*.db-journal
*.db-shm
*.db-wal

# Build-time icon intermediates — assets/generate_icon.py emits these
# locally; build_mac.sh copies them to the project root, where the
# tracked copies ship with the app.
assets/icon.icns
assets/icon.ico
assets/icon.png
